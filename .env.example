# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
ALLOWED_DOMAIN=muze.co.th

# Session signing secret - generate with: openssl rand -hex 32
SESSION_SECRET=

# Daily Planner - shared secret the external daily-generation job sends as the
# X-Planner-Secret header when POSTing that day's schedule to /api/planner
PLANNER_SECRET=

PORT=3000

# MTS Customer Support dashboard — reads the Jira->Sheet export (see
# mae-thongsuk-dashboard/ Apps Script). Grant the service account below
# Viewer access on the sheet itself.
MTSCS_SHEET_ID=
MTSCS_SHEET_RANGE=JiraData!A:Z
# Base64-encoded service account JSON (production). Locally, falls back to
# ./google-sheets-credentials.json if this is unset.
GOOGLE_SHEETS_CREDENTIALS_BASE64=
# Optional — turns ticket keys in the table into links to Jira
JIRA_BASE_URL=

# Nissan Mobile Application (ITSM) dashboard — reads the Jira Service Desk
# queue export (see nissan-mn-dashboard/ Apps Script). Grant the same
# service account used for MTSCS_SHEET_ID Viewer access on this sheet too.
NISSAN_SHEET_ID=
NISSAN_SHEET_RANGE=JiraData!A:Z

# TVN Error Sessions dashboard — reads AND WRITES the weekly rollup tab (gid
# 1205219259, name has changed at least once already so routes/tvn.js
# resolves the current name from the gid automatically) of the
# TVN-Operation Monitoring sheet - the page's own "Quick Record" panel
# writes new weekly values here directly. Grant the service account used for
# MTSCS_SHEET_ID **Editor** (not just Viewer) access on this sheet. Also
# used for the "Firebase Crashlytics" tab (gid 0) on the same spreadsheet.
TVN_SHEET_ID=

# Anthropic API key — used by /api/tvn/vision-read (routes/tvn.js ->
# lib/anthropicVision.js) to read a % value off an uploaded Bitmovin/
# Crashlytics dashboard screenshot via Claude vision, for a human to review
# before it's written to the sheet. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Operation Resource Planning — reads AND WRITES the "Daily Shortnote" tab of
# the team's Operation Resource Planning 2026 sheet, so the service account
# needs Editor (not just Viewer) access on this one.
RESOURCE_PLANNING_SHEET_ID=
RESOURCE_PLANNING_TAB=Daily Shortnote

# KTC Support Chat — given a pasted-in customer question, searches the KTC
# Jira project (description + comments, via API-token auth, not OAuth) and a
# baked-in Handover Document (data/ktc-handover.md), then shows the raw
# matches for a human to read (no LLM call, so no per-query API cost).
# Re-uses JIRA_BASE_URL above for both the API calls and the case links.
# Generate a token at https://id.atlassian.com/manage-profile/security/api-tokens
# for an account with read access to the KTC project.
JIRA_API_EMAIL=
JIRA_API_TOKEN=
